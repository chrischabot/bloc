# Server
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002

# Postgres
DATABASE_URL=postgres://bloc:bloc@localhost:5432/bloc_dev
DATABASE_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# MeiliSearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key

# Object storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bloc-files

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bloc-api
OTEL_LOG_LEVEL=info

# Auth
SESSION_SECRET=dev-session-secret-change-me-in-production
TOKEN_V2_SECRET=dev-token-v2-secret-change-me

# Email (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@bloc.local

# AI provider (stub in dev)
AI_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rate limiting
RATE_LIMIT_DISABLE=0